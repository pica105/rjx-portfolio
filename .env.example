# ── RJX Portfolio — URL configuration ──────────────────────────────
# Copy this file to `.env` and set your real URLs. Values are baked
# into the bundle at build time (Vite), so after editing run `npm run build`
# and restart the site.
#
# Local dev defaults (already set in .env) point to the sibling dev servers.
# On the VPS, replace them with http://YOUR_IP:PORT or your real domains.

# Portfolio project cards (opened in a new tab)
VITE_PROJECT_URL_AMBER=http://localhost:5174
VITE_PROJECT_URL_AURUM=http://localhost:5175
VITE_PROJECT_URL_MERIDIAN=http://localhost:5176
VITE_PROJECT_URL_UIMAILBOT=https://t.me/uimailbot

# "Get in touch" button (header / hero / CTA / footer)
VITE_TELEGRAM_URL=https://t.me/pica105
