[TEMPLATE]
# ── RJX Portfolio — URL configuration ──────────────────────────────
# Copy this file to `.env` and set your real URLs. Values are baked
# into the bundle at build time (Vite), so after editing run `npm run build`
# and restart the site.
#
# ⚠️ `.env` is gitignored — edit it ON THE SERVER (/root/sites/rjx-portfolio/.env),
# local changes never reach the deployment.
#
# Local dev defaults (already set in the local .env) point to the sibling
# dev servers. On the VPS the three project sites live under one domain:
#   https://rjx.synergyflow.ru/amber-terminal
#   https://rjx.synergyflow.ru/aurum-noir
#   https://rjx.synergyflow.ru/meridian-kimi

# Portfolio project cards — live site (right button, opened in a new tab)
VITE_PROJECT_URL_AMBER=https://rjx.synergyflow.ru/amber-terminal
VITE_PROJECT_URL_AURUM=https://rjx.synergyflow.ru/aurum-noir
VITE_PROJECT_URL_MERIDIAN=https://rjx.synergyflow.ru/meridian-kimi
VITE_PROJECT_URL_UIMAILBOT=https://t.me/uimailbot

# Portfolio project cards — GitHub repo (left button, opened in a new tab)
VITE_PROJECT_GITHUB_AMBER=https://github.com/pica105/amber-terminal
VITE_PROJECT_GITHUB_AURUM=https://github.com/pica105/aurum-noir
VITE_PROJECT_GITHUB_MERIDIAN=https://github.com/pica105/meridian-kimi
VITE_PROJECT_GITHUB_UIMAILBOT=https://github.com/pica105/uimailbot
VITE_PROJECT_GITHUB_WORKPARSER=https://github.com/pica105/work-parser
VITE_PROJECT_GITHUB_VIKA=https://github.com/pica105/real-ai-bot
VITE_PROJECT_GITHUB_AUTOTG=https://github.com/pica105/auto-tg
VITE_PROJECT_GITHUB_AIRESHALKA=https://github.com/pica105/ai-reshalka

# "Get in touch" button (header / hero / CTA / footer)
VITE_TELEGRAM_URL=https://t.me/pica105

# GitHub profile link (header + footer icon buttons)
VITE_GITHUB_PROFILE_URL=https://github.com/pica105
